<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Strunika.App</RootNamespace>
    <AssemblyTitle>Strunika</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Strunika.Core\Strunika.Core.csproj" />
    <ProjectReference Include="..\Strunika.Media\Strunika.Media.csproj" />
    <ProjectReference Include="..\Strunika.Neural\Strunika.Neural.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\ml\models\btc_large_voca.onnx" Link="models\btc_large_voca.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ml\models\btc_large_voca.json" Link="models\btc_large_voca.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ml\models\btc_guitar2.onnx" Link="models\btc_guitar2.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ml\models\btc_guitar2.json" Link="models\btc_guitar2.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
