<Window x:Class="Sideman.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sideman" Height="640" Width="920"
        Background="#1E1E24" Foreground="#EAEAEA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Dark-theme tab headers: the default template renders black
             text over our dark background. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A8A8B0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder" Background="Transparent"
                                Padding="16,9" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#6FB7FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#2A2A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2A2A33" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Мікрофон:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="300" ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"/>
                <Button Content="{Binding MicButtonText}" Command="{Binding ToggleMicCommand}"
                        Margin="10,0,0,0" Padding="12,4"/>
            </StackPanel>
        </Border>

        <TabControl Background="#1E1E24" BorderThickness="0">
            <TabItem Header="Тюнер">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Tuner.NoteName}" FontSize="120" FontWeight="Bold"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#EAEAEA"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tuner.InTune}" Value="True">
                                            <Setter Property="Foreground" Value="#4CD964"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Slider Width="420" Minimum="-50" Maximum="50" IsEnabled="False"
                                Value="{Binding Tuner.Cents, Mode=OneWay}" Margin="0,10"
                                TickPlacement="BottomRight" TickFrequency="10"/>
                        <Grid Width="420">
                            <TextBlock Text="♭ нижче" HorizontalAlignment="Left" Opacity="0.6"/>
                            <TextBlock Text="вище ♯" HorizontalAlignment="Right" Opacity="0.6"/>
                        </Grid>
                        <TextBlock Text="{Binding Tuner.Details}" FontSize="18" Opacity="0.8"
                                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Акорди наживо">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Live.ProvisionalChord}" FontSize="44"
                                   Foreground="#77808A" HorizontalAlignment="Center" MinHeight="58"
                                   Visibility="{Binding Live.NeuralAvailable, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Live.ConfirmedChord}" FontSize="150" FontWeight="Bold"
                                   Foreground="#6FB7FF" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Margin="0,26,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="Шумодав:" VerticalAlignment="Center" Opacity="0.7"/>
                            <Slider Width="220" Minimum="4" Maximum="24" TickFrequency="2"
                                    Value="{Binding Live.GateMarginDb}" Margin="10,0"/>
                            <TextBlock Text="{Binding Live.GateMarginDb, StringFormat={}{0:F0} дБ}"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                        <TextBlock Text="менше — чутливіший · більше — суворіший до шуму"
                                   FontSize="11" Opacity="0.45" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Історія" FontSize="16" Margin="0,0,0,6" Opacity="0.8"/>
                        <ListBox ItemsSource="{Binding Live.History}" Background="#2A2A33"
                                 Foreground="#EAEAEA" BorderThickness="0"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Джем 🥁">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                        <TextBlock Text="{Binding Jam.ChordText}" FontSize="120" FontWeight="Bold"
                                   Foreground="#FFB86C" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Jam.BpmText}" FontSize="30"
                                   Opacity="0.85" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding Jam.Status}" FontSize="15" Opacity="0.7"
                                   HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <Button Content="{Binding Jam.JamButtonText}"
                                Command="{Binding Jam.ToggleJamCommand}"
                                FontSize="20" Padding="26,10" HorizontalAlignment="Center"/>

                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/> <RowDefinition/> <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Барабани" Grid.Row="0" VerticalAlignment="Center" Opacity="0.75"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1"
                                    Value="{Binding Jam.DrumVolume}" VerticalAlignment="Center"/>
                            <TextBlock Text="Бас" Grid.Row="1" VerticalAlignment="Center" Opacity="0.75"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                                    Value="{Binding Jam.BassVolume}" VerticalAlignment="Center"/>
                            <TextBlock Text="Затримка" Grid.Row="2" VerticalAlignment="Center" Opacity="0.75"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="300"
                                    Value="{Binding Jam.LatencyMs}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Text="{Binding Jam.LatencyMs, StringFormat={}{0:F0}мс}"
                                       VerticalAlignment="Center" Opacity="0.6" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="Обов'язково грай у навушниках — інакше апка чутиме сама себе"
                                   FontSize="11" Opacity="0.45" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Пісня">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="Аналізувати"
                                Command="{Binding Song.AnalyzeCommand}" Padding="14,6" Margin="8,0,0,0"/>
                        <ComboBox DockPanel.Dock="Right" Width="90" Margin="8,0,0,0"
                                  ItemsSource="{Binding Song.EngineModes}"
                                  SelectedItem="{Binding Song.EngineMode}"
                                  ToolTip="Модель аналізу: Авто — записи через гітарну, файли/YouTube через базову. Для файлів із соло-гітарою обери «Гітара»."/>
                        <Button DockPanel.Dock="Right" Content="Огляд…"
                                Command="{Binding Song.BrowseCommand}" Padding="14,6" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Song.Source, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="6,4"
                                 Background="#2A2A33" Foreground="#EAEAEA" BorderBrush="#444"/>
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Left" Content="{Binding Song.RecordButtonText}"
                                Command="{Binding Song.ToggleRecordCommand}" Padding="14,6"
                                VerticalAlignment="Top"/>
                        <Button DockPanel.Dock="Right" Content="Лог"
                                Command="{Binding Song.OpenLogCommand}" Padding="10,6"
                                Margin="8,0,0,0" VerticalAlignment="Top" Opacity="0.7"/>
                        <!-- Read-only TextBox so error text is selectable and copyable. -->
                        <TextBox Text="{Binding Song.Status, Mode=OneWay}" IsReadOnly="True"
                                 Background="Transparent" Foreground="#EAEAEA" BorderThickness="0"
                                 TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0"
                                 IsTabStop="False"/>
                    </DockPanel>

                    <TextBlock Grid.Row="2" Text="{Binding Song.Summary}" FontSize="16"
                               Margin="0,12,0,6" FontWeight="SemiBold"/>

                    <DockPanel Grid.Row="3" Margin="0,4,0,8"
                               IsEnabled="{Binding Song.PlayerAvailable}">
                        <Button DockPanel.Dock="Left" Content="{Binding Song.PlayButtonText}"
                                Command="{Binding Song.PlayPauseCommand}" FontSize="18"
                                Width="46" Height="36"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Song.NowChord}"
                                   FontSize="26" FontWeight="Bold" Foreground="#6FB7FF"
                                   MinWidth="100" Margin="14,0" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Song.TimeText}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
                        <Slider Minimum="0" Maximum="{Binding Song.DurationSeconds}"
                                Value="{Binding Song.PositionSeconds, Mode=TwoWay}"
                                VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListView Grid.Row="4" x:Name="SongList" ItemsSource="{Binding Song.Segments}"
                              SelectedItem="{Binding Song.SelectedRow, Mode=TwoWay}"
                              SelectionChanged="SongList_SelectionChanged"
                              Background="#2A2A33" Foreground="#EAEAEA" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="#3A5C80"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Початок" Width="90" DisplayMemberBinding="{Binding Start}"/>
                                <GridViewColumn Header="Кінець" Width="90" DisplayMemberBinding="{Binding End}"/>
                                <GridViewColumn Header="Акорд" Width="140" DisplayMemberBinding="{Binding Chord}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
