<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sideman.App</RootNamespace>
    <AssemblyTitle>Sideman</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sideman.Core\Sideman.Core.csproj" />
    <ProjectReference Include="..\Sideman.Media\Sideman.Media.csproj" />
    <ProjectReference Include="..\Sideman.Neural\Sideman.Neural.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\ml\models\btc_large_voca.onnx" Link="models\btc_large_voca.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ml\models\btc_large_voca.json" Link="models\btc_large_voca.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ml\models\btc_guitar.onnx" Link="models\btc_guitar.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ml\models\btc_guitar.json" Link="models\btc_guitar.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Billboard mix model: wildcard so the build works before it exists. -->
    <Content Include="..\..\ml\models\btc_mix.onn*" Link="models\btc_mix.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\ml\models\btc_mix.jso*" Link="models\btc_mix.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
